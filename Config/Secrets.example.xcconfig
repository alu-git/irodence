// Secrets.xcconfig — REAL secrets, gitignored. Copy from Secrets.example.xcconfig and fill in.

// Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co

// Supabase anon (public) key — safe to ship in the app, protected by RLS
SUPABASE_ANON_KEY = your-anon-key-here

// WeChat Open Platform AppID (you'll provide this later)
WECHAT_APP_ID = wx0000000000000000
